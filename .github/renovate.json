{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>P4suta/renovate-config"],
  "packageRules": [
    {
      "description": "A Perl release with an odd minor number is a development snapshot.",
      "matchManagers": ["mise"],
      "matchDepNames": ["perl"],
      "allowedVersions": "/^5\\.\\d*[02468]\\./"
    },
    {
      "description": "The perl requirement of cpanfile states the oldest supported interpreter.",
      "matchManagers": ["cpanfile"],
      "matchDepNames": ["perl"],
      "enabled": false
    }
  ]
}
