#!perl
use v5.36;
use lib 't/lib';
use Library;

# Prints the Perl files of the kinds that the arguments name, one path on each line, for the formatter and the lint.

my $files   = Library::perl_files();
my @unknown = grep { !$files->{$_} } @ARGV;
die 'perl-files knows the kinds library, program, and input, and no ' . join( ', ', @unknown ) . "\n" if @unknown;
die "perl-files needs a kind: library, program, or input\n"                                           if !@ARGV;
say for map { $files->{$_}->@* } @ARGV;
